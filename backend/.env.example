PORT=3000
RPC_URL=http://127.0.0.1:8545
PUBLIC_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret

# Copy the private keys printed by `npx hardhat node` for local development.
# Never commit real keys or use Hardhat keys outside local development.
ORG_PRODUCER_PRIVATE_KEY=0xYOUR_ACCOUNT_1_PRIVATE_KEY
ORG_PROCESSOR_PRIVATE_KEY=0xYOUR_ACCOUNT_2_PRIVATE_KEY
ORG_TRANSPORTER_PRIVATE_KEY=0xYOUR_ACCOUNT_3_PRIVATE_KEY
ORG_WAREHOUSE_PRIVATE_KEY=0xYOUR_ACCOUNT_4_PRIVATE_KEY
ORG_RETAILER_PRIVATE_KEY=0xYOUR_ACCOUNT_5_PRIVATE_KEY
ORG_AUDITOR_PRIVATE_KEY=0xYOUR_ACCOUNT_6_PRIVATE_KEY
